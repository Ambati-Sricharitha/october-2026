class Solution:
    def minSumSquareDiff(self, nums1, nums2, k1, k2):
        diff = [abs(a - b) for a, b in zip(nums1, nums2)]
        k = k1 + k2

        if sum(diff) <= k:
            return 0

        diff.sort(reverse=True)

        left, right = 0, diff[0]

        while left < right:
            mid = (left + right) // 2
            ops = sum(max(0, d - mid) for d in diff)

            if ops <= k:
                right = mid
            else:
                left = mid + 1

        remaining = k - sum(max(0, d - left) for d in diff)

        ans = sum(min(d, left) ** 2 for d in diff)
        ans -= remaining * (left ** 2 - (left - 1) ** 2)

        return ans