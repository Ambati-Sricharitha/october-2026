class Solution:
    def shortestPath(self, n: int, edges: List[List[int]], labels: str, k: int) -> int:
        
        adj = [[] for _ in range(n)]
        for u, v, w in edges:
            adj[u].append((v, w))
            
        # dist[u][count] stores the minimum weight to reach node u 
        # with 'count' consecutive identical characters ending at u.
        # count ranges from 1 to k, so we use a size of (k + 1)
        dist = [[float('inf')] * (k + 1) for _ in range(n)]
        
        # Priority queue stores tuples of (current_distance, node, consecutive_count)
        # Start at node 0, with a consecutive count of 1 and distance 0
        pq = [(0, 0, 1)]
        dist[0][1] = 0
        
        while pq:
            d, u, count = heapq.heappop(pq)
            
            # If we reached the target node, since it's a min-heap, 
            # this is guaranteed to be the shortest valid path.
            if u == n - 1:
                return d
                
            # If we found a shorter path to this state already, skip it
            if d > dist[u][count]:
                continue
                
            # Explore all directed neighbors of u
            for v, w in adj[u]:
                if labels[v] == labels[u]:
                    next_count = count + 1
                    # Only transition if it doesn't violate the constraint
                    if next_count <= k:
                        if d + w < dist[v][next_count]:
                            dist[v][next_count] = d + w
                            heapq.heappush(pq, (d + w, v, next_count))
                else:
                    next_count = 1
                    if d + w < dist[v][next_count]:
                        dist[v][next_count] = d + w
                        heapq.heappush(pq, (d + w, v, next_count))
                        
        return -1
        
        