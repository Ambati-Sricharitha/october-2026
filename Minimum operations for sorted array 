class Solution:
    def solve(self, nums: list[int]) -> int:
        n = len(nums)
        if n <= 1:
            return 0
        
        # Find the index of 0
        idx0 = nums.index(0)
        
        # Check if it's an increasing cyclic shift
        is_increasing = True
        for i in range(n):
            if nums[(idx0 + i) % n] != i:
                is_increasing = False
                break
                
        if is_increasing:
            # Min of: direct left rotations OR (Reverse -> Left Rotations -> Reverse)
            return min(idx0, 2 + (n - idx0) % n)
            
        # Check if it's a decreasing cyclic shift
        is_decreasing = True
        for i in range(n):
            if nums[(idx0 - i + n) % n] != i:
                is_decreasing = False
                break
                
        if is_decreasing:
            # Min of: (Reverse -> Left Rotations) OR (Left Rotations -> Reverse)
            return min(n - idx0, (idx0 + 1) % n + 1)
            
        # If neither, it's impossible to sort
        return -1
