class Solution:
    def minOperations(self, s: str) -> int:
        # Check if the string is already sorted
        if all(s[i] <= s[i + 1] for i in range(len(s) - 1)):
            return 0
        
        # Strings of length 2 that are unsorted cannot be fixed
        if len(s) == 2:
            return -1
            
        mn = min(s)
        mx = max(s)
        
        # If the minimum character is at the start or maximum is at the end
        if s[0] == mn or s[-1] == mx:
            return 1
            
        # If minimum or maximum character appears anywhere in the middle
        if any(c == mn or c == mx for c in s[1:-1]):
            return 2
            
        # Worst-case scenario requires 3 operations
        return 3
